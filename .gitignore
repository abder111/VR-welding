# This .gitignore file is configured for Unity projects and macOS.

# [Ll]ibrary / [Tt]emp / [Oo]bj / [Bb]uilds / [Ll]ogs / [Uu]serSettings
/[Ww]elding-[Vv]R/[Ll]ibrary/
/[Ww]elding-[Vv]R/[Tt]emp/
/[Ww]elding-[Vv]R/[Oo]bj/
/[Ww]elding-[Vv]R/[Bb]uild/
/[Ww]elding-[Vv]R/[Bb]uilds/
/[Ww]elding-[Vv]R/[Ll]ogs/
/[Ww]elding-[Vv]R/[Uu]serSettings/
/[Ww]elding-[Vv]R/soudage.app/
/[Ww]elding-[Vv]R/Welding 101_BurstDebugInformation_DoNotShip/
/[Ww]elding-[Vv]R/mono_crash.*.json

# Autogenerated VS/VS Code/Rider files
/[Ww]elding-[Vv]R/*.csproj
/[Ww]elding-[Vv]R/*.sln
/[Ww]elding-[Vv]R/*.slnx
/[Ww]elding-[Vv]R/*.unityproj
/[Ww]elding-[Vv]R/*.userprefs
/[Ww]elding-[Vv]R/*.user
/[Ww]elding-[Vv]R/*.suo
/[Ww]elding-[Vv]R/*.suo.metadata
/[Ww]elding-[Vv]R/.vscode/
/[Ww]elding-[Vv]R/.idea/
/[Ww]elding-[Vv]R/.vs/

# Crash reports
/[Ww]elding-[Vv]R/CrashReport*

# Large asset exclusions to prevent GitHub push errors (due to size limit / HTTP timeout)
/[Ww]elding-[Vv]R/[Aa]ssets/[Oo]culus/
/[Ww]elding-[Vv]R/[Aa]ssets/[Ss]amples/
/[Ww]elding-[Vv]R/[Aa]ssets/_Backgrounds/
/[Ww]elding-[Vv]R/[Aa]ssets/_Objects/
/[Ww]elding-[Vv]R/[Aa]ssets/texture/
/[Ww]elding-[Vv]R/[Aa]ssets/LowPolyMetalRack/
/[Ww]elding-[Vv]R/[Aa]ssets/Screenshots/
/[Ww]elding-[Vv]R/[Aa]ssets/StreamingAssets/

# macOS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
